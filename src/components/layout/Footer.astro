---
import { siteConfig } from "@/config/site";
---

<footer class="border-t border-border bg-muted/50">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-10 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left lg:px-8"
  >
    <div>
      <p class="font-bold">{siteConfig.name}</p><p
        class="mt-1 text-sm text-muted-foreground"
      >
        Prova social para negócios que querem crescer.
      </p>
    </div>
    <a
      href="https://wa.me/5511961412794"
      target="_blank"
      rel="noopener noreferrer"
      class="font-semibold text-primary hover:underline"
      >Atendimento pelo WhatsApp</a
    >
  </div>
  <div
    class="border-t border-border px-6 py-5 text-center text-xs text-muted-foreground"
  >
    © {new Date().getFullYear()}
    {siteConfig.author}. Todos os direitos reservados.
  </div>
</footer>
